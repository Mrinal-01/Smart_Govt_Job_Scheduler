{
  "name": "studyos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm --prefix server run dev\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "npm --prefix server run dev",
    "build": "tsc --noEmit -p . && vite build",
    "build:all": "npm run build && npm --prefix server run build",
    "start": "npm --prefix server run start",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:all": "tsc --noEmit -p . && npm --prefix server run typecheck",
    "check": "npm run typecheck:all && npm run build:all",
    "setup": "npm install && npm --prefix server install",
    "deploy": "npm run build && wrangler pages deploy",
    "seed:master": "npm --prefix server run seed:master"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wrangler": "^4.110.0"
  }
}
