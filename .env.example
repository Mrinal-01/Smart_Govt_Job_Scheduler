# Web app (Vite). Copy to .env.local only if you need to change these.
# No secrets belong here — everything prefixed VITE_ is shipped to the browser.

# Leave empty to call the API on the same origin (dev: Vite proxies /api → STUDYOS_API_URL).
VITE_API_BASE_URL=

# Dev-server proxy target for /api (read by vite.config.ts, not shipped to the browser)
STUDYOS_API_URL=http://localhost:4000
