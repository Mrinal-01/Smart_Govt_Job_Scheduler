# ---------------------------------------------------------------------------
# StudyOS API — copy to server/.env and adjust. Never commit the real .env.
# Everything except MongoDB is optional for local development.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB (required)
MONGODB_URI=mongodb://127.0.0.1:27017/studyos

# Where the web app is served from (CORS allow-list, links in emails)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_APP_URL=http://localhost:3000
# Set to true behind a reverse proxy (correct client IPs for rate limiting)
TRUST_PROXY=false
# Production single-process mode: serve the built SPA from this folder
# SERVE_CLIENT_DIST=../dist
APP_TIMEZONE=Asia/Kolkata

# Secrets — REQUIRED in production (>= 32 random chars each). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development they are generated per boot if left empty.
JWT_ACCESS_SECRET=
FILE_SIGNING_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=true
# strict (same-site deployments) | lax | none (cross-site API; requires COOKIE_SECURE=true)
COOKIE_SAMESITE=strict
REQUIRE_EMAIL_VERIFICATION=true

# Google sign-in (optional). Create an OAuth 2.0 "Web application" client in
# Google Cloud Console and add your web origin to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Email: console (dev — links are logged and shown in the dev mailbox), resend, disabled
MAIL_DRIVER=console
MAIL_FROM=StudyOS <no-reply@your-domain.com>
RESEND_API_KEY=

# Uploads & PDF processing
STORAGE_DIR=./storage/private
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
# auto = use Tesseract if `pdftoppm` and `tesseract` are installed; none = disable OCR
OCR_PROVIDER=auto
OCR_LANG=eng

# AI (optional). Only "anthropic" is implemented. Keys stay on the server.
AI_PROVIDER=none
AI_API_KEY=
# Defaults to claude-opus-5-5
AI_MODEL=
AI_TIMEOUT_MS=120000
AI_DAILY_REQUEST_LIMIT=40
AI_MAX_OUTPUT_TOKENS=8000
# low | medium | high | xhigh | max
AI_EFFORT=medium

# Schedule change governance (system policy)
SCHEDULE_MAX_CHANGES=3
SCHEDULE_WINDOW_DAYS=7
