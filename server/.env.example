# ---------------------------------------------------------------------------
# StudyOS API — copy to server/.env and adjust. Never commit the real .env.
# Everything except MongoDB is optional for local development.
# What each value is and where to get keys/credentials: docs/SETUP.md › 3. Configuration
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB (required)
MONGODB_URI=mongodb://127.0.0.1:27017/studyos

# Where the web app is served from (CORS allow-list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_APP_URL=http://localhost:3000
# Set to true behind a reverse proxy (correct client IPs for rate limiting)
TRUST_PROXY=false
# Production single-process mode: serve the built SPA from this folder
# SERVE_CLIENT_DIST=../dist
APP_TIMEZONE=Asia/Kolkata

# Secrets — REQUIRED in production (>= 32 random chars each). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development they are generated per boot if left empty.
JWT_ACCESS_SECRET=
FILE_SIGNING_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=true
# strict (same-site deployments) | lax | none (cross-site API; requires COOKIE_SECURE=true)
COOKIE_SAMESITE=strict

# Phone + OTP sign-in
# Comma-separated country calling codes allowed for sign-up/login (91 = India: 10 digits starting 6–9)
PHONE_ALLOWED_COUNTRY_CODES=91
# HMAC key for stored OTP hashes (>= 32 chars, REQUIRED in production)
OTP_SECRET=
# console (dev: code is logged, returned as devOtp and listed at /api/dev/sms) | twilio | disabled
SMS_DRIVER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio phone number (E.164) or approved sender ID
TWILIO_FROM=

# Uploads & PDF processing
STORAGE_DIR=./storage/private
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
# auto = use Tesseract if `pdftoppm` and `tesseract` are installed; none = disable OCR
OCR_PROVIDER=auto
OCR_LANG=eng

# AI — OpenAI (Responses API). Step-by-step: docs/SETUP.md › 3.4. Keep AI_PROVIDER=none until you have a key; to switch it on:
#   AI_PROVIDER=openai   and   OPENAI_API_KEY=sk-...
# Everything else has sensible defaults. The key stays on the server.
AI_PROVIDER=none
OPENAI_API_KEY=
# Assistant / explanations model (default gpt-6.2-sol — OpenAI's default for most workloads)
AI_MODEL=
# Model that solves uploaded questions that have no answer key (default: same as AI_MODEL)
AI_ANSWER_MODEL=
AI_TIMEOUT_MS=120000
# Per student per day (AI Help, explanations)
AI_DAILY_REQUEST_LIMIT=40
# Whole server per day (background answering of question-hub questions)
AI_BACKGROUND_DAILY_LIMIT=2000
AI_MAX_OUTPUT_TOKENS=8000
# none | minimal | low | medium | high | xhigh | max
AI_EFFORT=medium
AI_ANSWER_EFFORT=high

# Schedule change governance (system policy)
SCHEDULE_MAX_CHANGES=3
SCHEDULE_WINDOW_DAYS=7
